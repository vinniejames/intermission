+/*
+ * intermission hands the person back to Claude between turns. They stay
+ * connected, but not as a target: no model, no collision, no damage. "join"
+ * puts them back through the normal spawn.
+ */
+static void
+SV_Spectate_f(client_t *client)
+{
+    edict_t *player;
+
+    if (!client->spawned || client->spectator)
+	return;
+    client->spectator = true;
+    player = client->edict;
+    player->v.movetype = MOVETYPE_NOCLIP;
+    player->v.solid = SOLID_NOT;
+    player->v.takedamage = DAMAGE_NO;
+    player->v.modelindex = 0;
+    player->v.effects = 0;
+    player->v.flags = (int)player->v.flags | FL_NOTARGET;
+    VectorCopy(vec3_origin, player->v.velocity);
+}
+
+static void
+SV_Join_f(client_t *client)
+{
+    edict_t *player;
+    int i;
+
+    if (!client->spawned || !client->spectator)
+	return;
+    client->spectator = false;
+    player = client->edict;
+    for (i = 0; i < NUM_SPAWN_PARMS; i++)
+	(&pr_global_struct->parm1)[i] = client->spawn_parms[i];
+    pr_global_struct->time = sv.time;
+    pr_global_struct->self = EDICT_TO_PROG(player);
+    PR_ExecuteProgram(pr_global_struct->PutClientInServer);
+}
+
