[Unit]
Description=intermission Quake server
After=network-online.target
Wants=network-online.target

[Service]
User=quake
WorkingDirectory=/opt/intermission
Environment=HOME=/opt/intermission
ExecStart=/opt/intermission/tyr-quake -dedicated 16 -basedir /opt/intermission -port 26000 +exec intermission.cfg
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
